{
  "name": "@mingu/interaction-ui",
  "version": "0.22.0",
  "private": true,
  "files": [
    "src",
    "styles.css",
    "interaction.css",
    "README.md",
    "tokens.css",
    "system.css",
    "DESIGN_SYSTEM.md",
    "examples",
    "COMPONENTS.md",
    "docs/collections",
    "dist/types"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./system": {
      "types": "./dist/types/system/index.d.ts",
      "default": "./src/system/index.tsx"
    },
    "./system.css": "./system.css",
    "./tokens.css": "./tokens.css",
    "./catalog": {
      "types": "./dist/types/system/ui-catalog.d.ts",
      "default": "./src/system/ui-catalog.ts"
    }
  },
  "sideEffects": [
    "./styles.css",
    "./interaction.css",
    "./tokens.css",
    "./system.css",
    "./src/collections/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run test:types",
    "test:browser": "playwright test",
    "build": "node docs/build.mjs && npm run build:types",
    "start": "node docs/server.mjs",
    "typecheck:docs": "tsc --noEmit -p docs/tsconfig.json",
    "test:docs": "npm run build && node --test docs/server.test.mjs",
    "test:ssr": "node --test tests/ssr-collections.mjs",
    "build:types": "tsc --project tsconfig.types.json",
    "prepare": "npm run build:types",
    "test:types": "npm run build:types && node --test tests/consumer-types.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "motion": "^14.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react-dom": "^19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Linternas/ui.git"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
