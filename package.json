{
  "name": "@mingu/interaction-ui",
  "version": "0.27.0",
  "private": true,
  "files": [
    "src",
    "styles.css",
    "interaction.css",
    "README.md",
    "tokens.css",
    "system.css",
    "DESIGN_SYSTEM.md",
    "examples",
    "COMPONENTS.md",
    "docs/collections",
    "dist/types",
    "packages/native/src",
    "packages/tokens/src",
    "NATIVE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./system": {
      "types": "./dist/types/system/index.d.ts",
      "default": "./src/system/index.tsx"
    },
    "./system.css": "./system.css",
    "./tokens.css": "./tokens.css",
    "./catalog": {
      "types": "./dist/types/system/ui-catalog.d.ts",
      "default": "./src/system/ui-catalog.ts"
    },
    "./native": {
      "types": "./dist/types/platforms/native/src/index.d.ts",
      "react-native": "./packages/native/src/index.ts",
      "default": "./packages/native/src/index.ts"
    },
    "./tokens": {
      "types": "./dist/types/platforms/tokens/src/index.d.ts",
      "default": "./packages/tokens/src/index.ts"
    }
  },
  "sideEffects": [
    "./styles.css",
    "./interaction.css",
    "./tokens.css",
    "./system.css",
    "./src/collections/*.css"
  ],
  "scripts": {
    "typecheck": "npm run tokens:check && tsc --noEmit && npm run typecheck:native && npm run test:types",
    "test:browser": "playwright test",
    "build": "npm run tokens:check && node docs/build.mjs && npm run build:types",
    "start": "node docs/server.mjs",
    "typecheck:docs": "tsc --noEmit -p docs/tsconfig.json",
    "test:docs": "npm run build && node --test docs/server.test.mjs",
    "test:ssr": "node --test tests/ssr-collections.mjs",
    "build:types": "tsc --project tsconfig.types.json && tsc --project tsconfig.native.types.json",
    "prepare": "npm run build:types",
    "test:types": "npm run build:types && node --test tests/consumer-types.mjs tests/native-consumer.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "typecheck:native": "tsc -p tsconfig.native.json && tsc -p tests/native/tsconfig.example.json",
    "test:native": "jest --config tests/native/jest.config.cjs --runInBand"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-native": ">=0.83",
    "react-native-safe-area-context": ">=5",
    "@react-native-community/datetimepicker": ">=8",
    "@react-native-community/slider": ">=5"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "motion": "^14.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-native-community/datetimepicker": "9.2.2",
    "@react-native-community/slider": "5.2.2",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "jest": "30.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "test-renderer": "1.3.1",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Linternas/ui.git"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "@react-native-community/slider": {
      "optional": true
    }
  }
}
